###############################################################################
# macOS                                                                       #
###############################################################################
.DS_Store
.AppleDouble
.LSOverride
# Finder's folder-icon file is named Icon followed by a carriage return.
# The bracket keeps names such as icons/ from being ignored on macOS, where Git ignores letter case.
Icon[!a-zA-Z0-9._-]
._*

###############################################################################
# Jekyll build artifacts                                                      #
###############################################################################
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
.jekyll-metadata*
.jekyll-cache-metadata
.jekyll-cache-loader/

###############################################################################
# Ruby / Bundler                                                              #
###############################################################################
.bundle/
vendor/bundle/
.byebug_history
.irb_history
.ruby-lsp/
.yardoc/
.yardoc
coverage/
tmp/

###############################################################################
# Node / Front-end                                                            #
###############################################################################
node_modules/

###############################################################################
# Editor / IDE                                                                #
###############################################################################
.vscode/
.idea/
*.code-workspace

###############################################################################
# Logs & temp                                                                 #
###############################################################################
legacy/*
*.log
*.swp
*.tmp
*.temp
*.bak
*.orig
*.rej
